msgctxt "DupesCuisine.STRINGS.SEEDS.KAKAWATREE.SEED_DESC"
msgid "<link=\"PLANTS\">Семя</link> <link=\"KAKAWATREE\">дерева какава</link>.\n\nЖёлудь можно посеять, чтобы вырастить больше деревьев какава, или переработать для получения <link=\"FOOD\">еды</link>."
msgstr ""

#. DupesCuisine.STRINGS.SEEDS.KAKAWATREE.SEED_NAME
msgctxt "DupesCuisine.STRINGS.SEEDS.KAKAWATREE.SEED_NAME"
msgid "<link=\"KAKAWATREE\">Какава-жёлудь</link>"
msgstr ""

#. DupesCuisine.STRINGS.SEEDS.SUNNYWHEAT.SEED_DESC
msgctxt "DupesCuisine.STRINGS.SEEDS.SUNNYWHEAT.SEED_DESC"
msgid "<link=\"PLANTS\">Семя</link> <link=\"SUNNYWHEAT\">солнечной пшеницы</link>.\n\nЗерно можно посеять, чтобы вырастить больше солнечной пшеницы, или переработать для получения <link=\"FOOD\">еды</link>."
msgstr ""

