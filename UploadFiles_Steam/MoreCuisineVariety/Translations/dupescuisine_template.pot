msgstr ""

#. DupesCuisine.STRINGS.FOOD.COOKEDSHARD.DESC
msgctxt "DupesCuisine.STRINGS.FOOD.COOKEDSHARD.DESC"
msgid "Запечённая <link=\"SWAMPFORAGEPLANT\">сердцевина болотного мангольда</link>.\n\nНа вкус лучше, чем на вид, но на запах так же плохо, как и на вкус."
msgstr ""

