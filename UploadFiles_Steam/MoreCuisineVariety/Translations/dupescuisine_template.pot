msgstr ""

#. DupesCuisine.STRINGS.FOOD.COOKIE.DESC
msgctxt "DupesCuisine.STRINGS.FOOD.COOKIE.DESC"
msgid "Песочное печенье, приготовленное из горьковатой <link=\"ROASTEDKAKAWA\">жареной какавы</link>, <link=\"KAKAWABUTTER\">какава-масла</link> и <link=\"COLDWHEATSEED\">зерен морозной пшеницы</link>."
msgstr ""

