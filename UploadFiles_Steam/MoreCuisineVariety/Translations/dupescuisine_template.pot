msgctxt "DupesCuisine.STRINGS.FOOD.NOSHPUDDING.NAME"
msgid "<link=\"NOSHPUDDING\">Заварной флан</link>"
msgstr ""

#. DupesCuisine.STRINGS.FOOD.NOSHPUDDING.RECIPEDESC
msgctxt "DupesCuisine.STRINGS.FOOD.NOSHPUDDING.RECIPEDESC"
msgid "Изысканный сладкий десерт."
msgstr ""

#. DupesCuisine.STRINGS.FOOD.NUTCAKE.DESC
msgctxt "DupesCuisine.STRINGS.FOOD.NUTCAKE.DESC"
msgid "Ароматный <link=\"NUTCAKE\">кекс</link>, приготовленный из горьковатой <link=\"ROASTEDKAKAWA\">жареной какавы</link>, <link=\"KAKAWABUTTER\">какава-масла</link> и <link=\"SUNNYWHEATSEED\">зерен солнечной пшеницы</link>.\n\nСогревает сердце (и желудок) дубликанта."
msgstr ""

#. DupesCuisine.STRINGS.FOOD.NUTCAKE.NAME
msgctxt "DupesCuisine.STRINGS.FOOD.NUTCAKE.NAME"
msgid "<link=\"NUTCAKE\">Какавовый кекс</link>"
msgstr ""

#. DupesCuisine.STRINGS.FOOD.NUTCAKE.RECIPEDESC
msgctxt "DupesCuisine.STRINGS.FOOD.NUTCAKE.RECIPEDESC"
msgid "Ароматный <link=\"NUTCAKE\">кекс</link>, приготовленный из горьковатой <link=\"ROASTEDKAKAWA\">жареной какавы</link>, <link=\"KAKAWABUTTER\">какава-масла</link> и <link=\"SUNNYWHEATSEED\">зерен солнечной пшеницы</link>."
msgstr ""

#. DupesCuisine.STRINGS.FOOD.NUTPIE.DESC
msgctxt "DupesCuisine.STRINGS.FOOD.NUTPIE.DESC"
msgid "Изысканный торт, испеченный из <link=\"COLDWHEATSEED\">зёрен морозной пшеницы</link> и <link=\"RAWEGG\">яиц</link>, с начинкой из карамелизированных в <link=\"SUCROSE\">сахарозе</link> <link=\"WORMBASICFOOD\">жареных орехов личинкокоса</link>.\n\nМаслянистая корочка позволяет ему долго оставаться свежим."
msgstr ""

#. DupesCuisine.STRINGS.FOOD.NUTPIE.NAME
msgctxt "DupesCuisine.STRINGS.FOOD.NUTPIE.NAME"
msgid "<link=\"NUTPIE\">Нуссторте</link>"
msgstr ""

#. DupesCuisine.STRINGS.FOOD.NUTPIE.RECIPEDESC
msgctxt "DupesCuisine.STRINGS.FOOD.NUTPIE.RECIPEDESC"
msgid "Изысканный торт с карамелизированной начинкой."
msgstr ""

#. DupesCuisine.STRINGS.FOOD.PLANTBURGER.DESC
msgctxt "DupesCuisine.STRINGS.FOOD.PLANTBURGER.DESC"
msgid "Аппетитное <link=\"GRILLEDPLANTMEAT\">жареное растительное мясо</link> и <link=\"LETTUCE\">салат</link>, спрессованные вместе внутри разрезанного пополам <link=\"MEALBREAD\">пищбрöта</link>.\n\nОдин укус и по телу пробегает волна приятных мурашек."
msgstr ""

#. DupesCuisine.STRINGS.FOOD.PLANTBURGER.NAME
msgctxt "DupesCuisine.STRINGS.FOOD.PLANTBURGER.NAME"
msgid "<link=\"PLANTBURGER\">Растительный бургер</link>"
msgstr ""

#. DupesCuisine.STRINGS.FOOD.PLANTBURGER.RECIPEDESC
msgctxt "DupesCuisine.STRINGS.FOOD.PLANTBURGER.RECIPEDESC"
msgid "Аппетитное <link=\"GRILLEDPLANTMEAT\">жареное растительное мясо</link> и <link=\"LETTUCE\">салат</link>, спрессованные вместе внутри разрезанного пополам <link=\"MEALBREAD\">пищбрöта</link>."
msgstr ""

#. DupesCuisine.STRINGS.FOOD.ROASTEDKAKAWA.DESC
msgctxt "DupesCuisine.STRINGS.FOOD.ROASTEDKAKAWA.DESC"
msgid "Полностью обжаренный <link=\"KAKAWATREESEED\">жёлудь какавы</link>.\n\nВ процессе обжарки его твердая скорлупа трескается, обнажая съедобное ядро. Но опыт употребление его в пищу будет определенно горьким."
msgstr ""

#. DupesCuisine.STRINGS.FOOD.ROASTEDKAKAWA.NAME
msgctxt "DupesCuisine.STRINGS.FOOD.ROASTEDKAKAWA.NAME"
msgid "<link=\"ROASTEDKAKAWA\">Жареная какава</link>"
msgstr ""

#. DupesCuisine.STRINGS.FOOD.ROASTEDKAKAWA.RECIPEDESC
msgctxt "DupesCuisine.STRINGS.FOOD.ROASTEDKAKAWA.RECIPEDESC"
msgid "Полностью обжаренный <link=\"KAKAWATREESEED\">желудь какавы</link>."
msgstr ""

#. DupesCuisine.STRINGS.FOOD.SALTEDMEAT.DESC
msgctxt "DupesCuisine.STRINGS.FOOD.SALTEDMEAT.DESC"
msgid "Кусок <link=\"MEAT\">мяса</link>, выдержанный в большом количестве <link=\"SALT\">соли</link>.\n\nВысокая концентрация соли в этом мясе сделала его устойчивым к микроорганизмам, вызывающим порчу продуктов при обычных условиях."
msgstr ""

#. DupesCuisine.STRINGS.FOOD.SALTEDMEAT.NAME
msgctxt "DupesCuisine.STRINGS.FOOD.SALTEDMEAT.NAME"
msgid "<link=\"SALTEDMEAT\">Солонина</link>"
msgstr ""

#. DupesCuisine.STRINGS.FOOD.SALTEDMEAT.RECIPEDESC
msgctxt "DupesCuisine.STRINGS.FOOD.SALTEDMEAT.RECIPEDESC"
msgid "Кусок <link=\"MEAT\">мяса</link>, выдержанный в большом количестве <link=\"SALT\">соли</link>."
msgstr ""

#. DupesCuisine.STRINGS.FOOD.SEATACO.DESC
msgctxt "DupesCuisine.STRINGS.FOOD.SEATACO.DESC"
msgid "Сытное блюдо, приготовленное из медленно <link=\"COOKEDFISH\">обжаренных морепродуктов</link> и <link=\"LETTUCE\">салата</link>, подается с <link=\"FLATBREAD\">тортильей</link>.\n\nОставляет ощущение теплоты и на входе, и на выходе."
msgstr ""

#. DupesCuisine.STRINGS.FOOD.SEATACO.NAME
msgctxt "DupesCuisine.STRINGS.FOOD.SEATACO.NAME"
msgid "<link=\"SEATACO\">Морское тако</link>"
msgstr ""

#. DupesCuisine.STRINGS.FOOD.SEATACO.RECIPEDESC
msgctxt "DupesCuisine.STRINGS.FOOD.SEATACO.RECIPEDESC"
msgid "Сытное блюдо, приготовленное из медленно <link=\"COOKEDFISH\">обжаренных морепродуктов</link> и <link=\"LETTUCE\">салата</link>, подается с <link=\"FLATBREAD\">тортильей</link>."
msgstr ""

#. DupesCuisine.STRINGS.FOOD.SPICEDOMELETTE.DESC
msgctxt "DupesCuisine.STRINGS.FOOD.SPICEDOMELETTE.DESC"
msgid "Воздушное блюдо, приготовленное из взбитых <link=\"RAWEGG\">яиц</link> и с щедрой щепоткой <link=\"SPICENUT\">перцовых орехов</link>.\n\nОбладает глубоким пряным вкусом, который надолго остается во рту."
msgstr ""

#. DupesCuisine.STRINGS.FOOD.SPICEDOMELETTE.NAME
msgctxt "DupesCuisine.STRINGS.FOOD.SPICEDOMELETTE.NAME"
msgid "<link=\"SPICEDOMELETTE\">Омлет со специями</link>"
msgstr ""

#. DupesCuisine.STRINGS.FOOD.SPICEDOMELETTE.RECIPEDESC
msgctxt "DupesCuisine.STRINGS.FOOD.SPICEDOMELETTE.RECIPEDESC"
msgid "Воздушное блюдо, приготовленное из взбитых <link=\"RAWEGG\">яиц</link> и с щедрой щепоткой <link=\"SPICENUT\">перцовых орехов</link>"
msgstr ""

#. DupesCuisine.STRINGS.PLANTS.CREAMCAPMUSHROOM.DESC
msgctxt "DupesCuisine.STRINGS.PLANTS.CREAMCAPMUSHROOM.DESC"
msgid "Бархатистый гриб со светлой ножкой и шляпкой кремового цвета. Несмотря на то, что он растёт в сырых и тёмных местах, его <link=\"CREAMTOPCAP\">шляпка</link> очень даже съедобная."
msgstr ""

#. DupesCuisine.STRINGS.PLANTS.CREAMCAPMUSHROOM.DOMESTICATED_DESC
msgctxt "DupesCuisine.STRINGS.PLANTS.CREAMCAPMUSHROOM.DOMESTICATED_DESC"
msgid "Созревает, и получается съедобная <link=\"CREAMTOPCAP\">шляпка кремпиньона</link>."
msgstr ""

#. DupesCuisine.STRINGS.PLANTS.CREAMCAPMUSHROOM.NAME
msgctxt "DupesCuisine.STRINGS.PLANTS.CREAMCAPMUSHROOM.NAME"
msgid "<link=\"CREAMCAP\">Кремпиньон</link>"
msgstr ""

#. DupesCuisine.STRINGS.PLANTS.KAKAWATREE.DESC
msgctxt "DupesCuisine.STRINGS.PLANTS.KAKAWATREE.DESC"
msgid "Пышное дерево с золотистыми листьями, растущее в лесных биомах с умеренной температурой. На нем созревают твердые, как камень, но вполне съедобные <link=\"KAKAWATREESEED\">какава-жёлуди</link>."
msgstr ""

#. DupesCuisine.STRINGS.PLANTS.KAKAWATREE.DOMESTICATED_DESC
msgctxt "DupesCuisine.STRINGS.PLANTS.KAKAWATREE.DOMESTICATED_DESC"
msgid "На этом растении созревают съедобные <link=\"KAKAWATREESEED\">какава-жёлуди</link>."
msgstr ""

#. DupesCuisine.STRINGS.PLANTS.KAKAWATREE.NAME
msgctxt "DupesCuisine.STRINGS.PLANTS.KAKAWATREE.NAME"
msgid "<link=\"KAKAWATREE\">Дерево какава</link>"
msgstr ""

#. DupesCuisine.STRINGS.PLANTS.SUNNYWHEAT.DESC
msgctxt "DupesCuisine.STRINGS.PLANTS.SUNNYWHEAT.DESC"
msgid "Яркий злак, произрастающий в умеренных и жарких биомах. На нем созревают <link=\"SUNNYWHEATSEED\">зёрна солнечной пшеницы</link>, пригодные для переработки в пищу."
msgstr ""

#. DupesCuisine.STRINGS.PLANTS.SUNNYWHEAT.DOMESTICATED_DESC
msgctxt "DupesCuisine.STRINGS.PLANTS.SUNNYWHEAT.DOMESTICATED_DESC"
msgid "На этом растении созревают съедобные <link=\"SUNNYWHEATSEED\">зёрна солнечной пшеницы</link>."
msgstr ""

#. DupesCuisine.STRINGS.PLANTS.SUNNYWHEAT.NAME
msgctxt "DupesCuisine.STRINGS.PLANTS.SUNNYWHEAT.NAME"
msgid "<link=\"SUNNYWHEAT\">Солнечная пшеница</link>"
msgstr ""

#. DupesCuisine.STRINGS.SEEDS.CREAMCAPMUSHROOM.SEED_DESC
msgctxt "DupesCuisine.STRINGS.SEEDS.CREAMCAPMUSHROOM.SEED_DESC"
msgid "<link=\"PLANTS\">Семя</link> <link=\"CREAMCAP\">кремпиньона</link>.\n\nНайти споры кремпиньона можно, выкапывая предметы из земли."
msgstr ""

